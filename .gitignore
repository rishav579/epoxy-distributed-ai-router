.local-e2e-logs/
benchmark_dataset.csv
benchmark_report.md
*.log

# Environment files and credentials
.env
.env.*
!.env.example
*.pem
*.key
*.crt

# Terraform state, plans, provider/plugin directories, and local overrides
**/.terraform/
*.tfstate
*.tfstate.*
*.tfplan
crash.log
crash.*.log
*.tfvars
*.tfvars.json
!*.tfvars.example

# Terraform provider lock file is intentionally tracked when generated
